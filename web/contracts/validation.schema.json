{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "detections": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "patternId": { "type": "string" },
          "detected": { "type": "boolean", "const": true },
          "textSpan": { "type": "string" },
          "hint": { "type": "string" }
        },
        "required": ["patternId", "detected", "textSpan", "hint"]
      }
    }
  },
  "required": ["detections"]
}
