# The absolute path is optional. The loader also checks ../research/personal_error_profile.json.
# PERSONAL_ERROR_PROFILE_PATH=/absolute/path/to/personal_error_profile.json
# PERSONAL_ERROR_TIMELINE_PATH=/absolute/path/to/error_timeline.csv

# Set to false to disable local research JSONL logging.
RESEARCH_LOGGING=true

# AI backend: "gemini" uses the Gemini API; "codex" remains available as a local fallback.
AI_PROVIDER=gemini
# Keep this private: never use a NEXT_PUBLIC_ prefix and never commit .env.local.
GEMINI_API_KEY="your_gemini_api_key"
# Fast, economical requests: task analysis, Top-3 ranking, and short live checks.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# More demanding but user-requested decisions: detailed explanations.
GEMINI_MODEL_SMART=gemini-3.5-flash
# One full-essay final audit, only after the student selects Finish & review.
GEMINI_MODEL_FINAL=gemini-3.6-flash
# Legacy alternative: GEMINI_MODEL is still accepted as the fast-model setting.
