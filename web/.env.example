# The absolute path is optional. The loader also checks ../research/personal_error_profile.json.
# PERSONAL_ERROR_PROFILE_PATH=/absolute/path/to/personal_error_profile.json
# PERSONAL_ERROR_TIMELINE_PATH=/absolute/path/to/error_timeline.csv

# Set to false to disable local research JSONL logging.
RESEARCH_LOGGING=true

# The local demo backend. "codex" is the default and runs Codex CLI only on the server.
AI_PROVIDER=codex
